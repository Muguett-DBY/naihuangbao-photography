{
  "name": "portrait-booking-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "avif": "node scripts/convert-to-avif.mjs",
    "build": "npm run avif && tsc -b && vite build && npm run spa:404",
    "build:full": "npm run seo:sync && npm run sitemap:build && npm run avif && tsc -b && vite build && npm run spa:404 && npm run perf:budget && npm run bundle:analyze",
    "preview": "vite preview --host 0.0.0.0",
    "sitemap:build": "node --import tsx/esm scripts/build-sitemap.ts",
    "bundle:analyze": "node scripts/analyze-bundle.mjs",
    "typecheck": "tsc -b --noEmit",
    "architecture:check": "node scripts/check-architecture.mjs",
    "deadcode:check": "knip --include files,dependencies,unlisted,binaries,duplicates",
    "lint": "npm run typecheck && npm run architecture:check && npm run deadcode:check",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "verify": "npm run lint && npm run test && npm run build:full",
    "verify:release": "npm run verify && npm run test:e2e",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "seo:sync": "node --import tsx/esm scripts/sync-seo-shell.mjs",
    "spa:404": "node scripts/sync-spa-404.mjs",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "assets:crop": "node scripts/crop-gallery-assets.mjs",
    "deps:audit": "npm audit --audit-level=moderate && npm install-scripts ls"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "animal-island-ui": "^1.4.0",
    "face-api.js": "^0.22.2",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "i18next": "^26.3.6",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.25",
    "lucide-react": "^1.28.0",
    "photoswipe": "^5.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-leaflet": "^5.0.0",
    "react-router": "8.3.0",
    "swiper": "^14.0.7",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.8",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@playwright/test": "^1.62.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "0.185.3",
    "@vitejs/plugin-react": "6.0.3",
    "knip": "^6.31.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "@tensorflow/tfjs-core": {
      "node-fetch": "2.6.7"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260730.1": true
  }
}
